---
layout: null
---

<?xml version="1.0" encoding="UTF-8"?>
<rss version="2.0">
  <channel>
    <title>{{ site.title }}</title>
    <link>{{ site.url }}</link>
    <description>{{ site.description }}</description>

    {% assign docs = site.windows | sort: "modified" | reverse %}
    {% for doc in docs limit:50 %}
    <item>
      <title>{{ doc.title }}</title>
      <link>{{ site.url }}{{ doc.url }}</link>
      <guid>{{ site.url }}{{ doc.url }}</guid>
      <pubDate>{{ doc.modified | date_to_rfc822 }}</pubDate>
      <description>
        {{ doc.excerpt | strip_html | xml_escape }}
      </description>
    </item>
    {% endfor %}

  </channel>
</rss>